# Public build-time values; these are not service-role credentials.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: enable matching Turnstile CAPTCHA in Supabase Auth before using.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only. Never add NEXT_PUBLIC_ to these variables.
APP_ORIGIN=https://your-domain.example
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REQUIRE_DISTRIBUTED_RATE_LIMIT=true
# Set only when your reverse proxy overwrites this header and cannot be bypassed.
TRUSTED_PROXY_IP_HEADER=
# Temporary application allowlist of confirmed admin emails, comma-separated.
# Database RLS still requires app_metadata.cms_role=admin.
CMS_ADMIN_EMAILS=
